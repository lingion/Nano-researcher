{
  "name": "local-policy-agent",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:policy && pnpm build:generic",
    "build:policy": "tsc -p tsconfig.json",
    "build:generic": "tsc -p tsconfig.generic.json",
    "test": "tsx --test \"__tests__/**/*.test.ts\" \"src/**/*.test.ts\"",
    "start": "pnpm generic-agent",
    "policy-scanner": "tsx bin/policy-scanner.ts",
    "live-audit": "tsx src/app/run-live-audit.ts",
    "legacy-audit": "tsx src/app/run-live-audit.ts",
    "generic-agent": "tsx src/app/run-generic-agent.ts",
    "generic-http": "tsx src/adapters/http/start.ts",
    "generic-mcp": "tsx src/adapters/mcp/start.ts",
    "install:browsers": "playwright install chromium",
    "test:fixture": "tsx --test __tests__/fixtures/golden-live-audit.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.154",
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "playwright": "^1.55.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}
