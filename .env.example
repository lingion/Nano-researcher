# Copy this file to .env for Generic Agent live runs.
# Tests and pnpm build do not require live credentials.

# Required for the Generic CLI, HTTP, and MCP adapters.
NANOCLAW_BASE_URL=https://<your-openai-compatible-gateway>/v1/chat/completions
NANOCLAW_API_KEY=<your-gateway-key>

# Optional model override. If unset, runtime falls back through configured defaults.
# POLICY_AGENT_LLM_MODEL=gpt-5.4
# NANOCLAW_MODEL=gpt-5.4

# Generic CLI task and bounded completion mode.
RESEARCH_QUESTION=<your-research-question>
# Optional domain: loads domains/<domain>.md as the system prompt and may apply
# engine scope / completion defaults from its frontmatter. Built-in domains:
# "general" (default) and "policy" (China product/tool radar). Omit for the
# domain-agnostic generic agent.
# RESEARCH_DOMAIN=policy
# RESEARCH_DOMAINS_DIR=./domains
# RESEARCH_COMPLETION_MODE=target_results
# RESEARCH_TARGET_RESULTS=10
# RESEARCH_MAX_ITERATIONS=100
# RESEARCH_EVIDENCE_REQUIRED=1
# RESEARCH_MIN_FETCHED_PAGES=10
# RESEARCH_MAX_SEARCH_ACTIONS=8
# RESEARCH_MAX_FETCH_ACTIONS=8
# RESEARCH_OUTPUT_FORMAT=markdown
# RESEARCH_RUN_TIMEOUT_MS=1800000

# Generic HTTP adapter. Non-loopback binding requires an auth token.
# RESEARCH_HTTP_HOST=127.0.0.1
# RESEARCH_HTTP_PORT=8787
# RESEARCH_HTTP_AUTH_TOKEN=<your-http-bearer-token>
# RESEARCH_OUTPUT_DIR=./artifacts/runs
# RESEARCH_EVIDENCE_DIR=./artifacts/runs/evidence
# RESEARCH_EXPOSE_ATOMIC_TOOLS=0

# Legacy policy runtime only.
# LIVE_AUDIT_TOPIC=<legacy-policy-topic>
# LIVE_AUDIT_MAX_ITERATIONS=10
# POLICY_TARGET_VALIDATED_COUNT=4
# SEARCH_MCP_WORKER_PATH=./vendor/search-mcp/src/stdio-server.js
# LIVE_AUDIT_DEBUG=1
# LIVE_AUDIT_DIAG=1
