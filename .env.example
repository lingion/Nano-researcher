# Copy this file to .env for live audit runs.
# Offline fixture tests and pnpm build do not require these values.

# Required for OpenAI-compatible NanoClaw gateway live runs.
NANOCLAW_LLM_PROVIDER=openai
NANOCLAW_BASE_URL=https://<your-openai-compatible-gateway>/v1/chat/completions
NANOCLAW_API_KEY=<your-gateway-key>

# Optional model override. If unset, runtime falls back through configured defaults.
# POLICY_AGENT_LLM_MODEL=gpt-5.4
# NANOCLAW_MODEL=gpt-5.4

# Optional: override the vendored Search MCP stdio worker path only if you are pointing to a different worker checkout.
# SEARCH_MCP_WORKER_PATH=./vendor/search-mcp/src/stdio-server.js

# Optional diagnostics.
# LIVE_AUDIT_DEBUG=1
# LIVE_AUDIT_DIAG=1
